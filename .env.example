# ── Cloudflare R2 配置（同步脚本使用）─────────────────────
# Account ID：Cloudflare 控制台首页右侧可看到
R2_ACCOUNT_ID=
# API Token：R2 → Manage R2 API Tokens → Create Account API token（选 Object Read & Write，限定 bucket）
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# S3 API 端点（可选）：不填则按 R2_ACCOUNT_ID 自动生成
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# 你创建的 bucket 名称（必填）
R2_BUCKET=

# 内容目录（Obsidian vault 的位置，相对项目根目录或绝对路径）
CONTENT_DIR=/Users/andycort/Library/Mobile Documents/iCloud~md~obsidian/Documents/Base
# vault 里文章所在的子目录名（默认 posts，vault 里叫 _posts 就填 _posts）
R2_POSTS_SUBDIR=_posts

# ── 内容 API（Cloudflare Worker + D1，推荐替代 R2）────────────────
# Worker 部署后的地址，例如 https://oblivion-content.xxx.workers.dev
WORKER_URL=
# 发布接口密钥，与 Worker 的 PUBLISH_SECRET 保持一致
PUBLISH_SECRET=
# vault 里文章所在的子目录名（不填则沿用上面的 R2_POSTS_SUBDIR）
# POSTS_SUBDIR=_posts

# ── 前端读取用的内容 API 地址（Vite 构建时读取）──────────────────
# 填 Worker 地址，例如 https://oblivion-content.xxx.workers.dev
# 留空则使用 VITE_API_URL 或同源 /api
VITE_CONTENT_API_URL=
