---
/**
 * Footer.astro — Static footer, zero JS
 */
---

<footer class="site-footer">
  <p>
    © 2001 ~ {new Date().getFullYear()} Oblivion. Designed by <a
      href="https://inpa.in"
      target="_blank"
      rel="noopener noreferrer">Anya</a
    >.
  </p>
  <p>All rights reserved.</p>
  <p>
    Powered by <a
      href="https://astro.build"
      target="_blank"
      rel="noopener noreferrer">Astro</a
    >.
  </p>
</footer>

<style>
  .site-footer {
    text-align: center;
    margin: 0;
    border-top: var(--border);
    margin-top: -1px;
    padding: 20px 16px calc(20px + env(safe-area-inset-bottom, 0px));

    p {
      white-space: normal;
      margin: 5px 0;
      font-family: var(--content-font);
      font-size: 1em;
      color: var(--text-3);
    }
  }
</style>
