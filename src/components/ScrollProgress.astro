---
/**
 * ScrollProgress.astro — CSS only scroll progress bar
 */
---

<div class="scroll-progress-bar"></div>

<style>
  .scroll-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--main-color);
    z-index: 10001;
    transform-origin: left;
    transform: scaleX(0);
    animation: scroll-progress linear;
    animation-timeline: scroll(root);
  }

  @keyframes scroll-progress {
    from {
      transform: scaleX(0);
    }

    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-progress-bar {
      animation: none;
    }
  }
</style>
