---
/**
 * NavBar.astro — Static Astro navigation bar with minimal inline JS
 * for scroll hide/show and mobile menu toggle.
 */
import { t, getLocale } from "../i18n/utils";

const locale = getLocale();
const siteName = t("siteName", locale);

const menuItems = [
  { key: "home", path: "/" },
  { key: "articles", path: "/" },
  { key: "about", path: "/about" },
];
---

<nav class="nav-bar" id="main-nav">
  <div class="nav-left">
    <a href="/">{siteName}</a>
  </div>

  <button class="menu-toggle" id="menu-toggle" aria-label="Toggle menu">
    <i class="fas fa-bars" id="menu-icon"></i>
  </button>

  <div class="nav-content" id="nav-content">
    <ul class="nav-menu">
      {
        menuItems.map((item, index) => (
          <li style={`--i: ${index}`}>
            <a href={item.path} data-nav-key={item.key}>
              {t(`nav.${item.key}`, locale)}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Mobile search (visible on small screens) -->
    <div class="nav-right mobile-only">
      <div class="nav-search">
        <form action="/search" method="get">
          <input
            type="search"
            name="s"
            placeholder={t("search.placeholder", locale)}
            class="search-input"
          />
          <button type="submit" aria-label="Search">
            <i class="fas fa-magnifying-glass"></i>
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Desktop search -->
  <div class="nav-right desktop-only" id="desktop-nav-right">
    <div class="nav-search" id="desktop-search">
      <form action="/search" method="get">
        <input
          type="search"
          name="s"
          placeholder={t("search.placeholder", locale)}
          class="search-input"
          id="search-input"
        />
        <button type="button" id="search-toggle" aria-label="Toggle search">
          <i class="fas fa-magnifying-glass"></i>
        </button>
      </form>
    </div>
  </div>
</nav>

<div class="mobile-overlay" id="mobile-overlay"></div>

<script>
  // Nav scroll hide/show
  let lastScrollY = 0;
  const nav = document.getElementById("main-nav")!;

  window.addEventListener(
    "scroll",
    () => {
      const scrollY = window.scrollY;
      if (scrollY > 100) {
        nav.classList.toggle("nav-hidden", scrollY > lastScrollY);
      } else {
        nav.classList.remove("nav-hidden");
      }
      lastScrollY = scrollY;
    },
    { passive: true },
  );

  // Mobile menu
  const toggle = document.getElementById("menu-toggle")!;
  const content = document.getElementById("nav-content")!;
  const overlay = document.getElementById("mobile-overlay")!;
  const icon = document.getElementById("menu-icon")!;

  function closeMobileMenu() {
    content.classList.remove("mobile-open");
    overlay.classList.remove("active");
    toggle.classList.remove("active");
    icon.className = "fas fa-bars";
    document.body.style.overflow = "";
  }

  toggle.addEventListener("click", () => {
    const isOpen = content.classList.contains("mobile-open");
    if (isOpen) {
      closeMobileMenu();
    } else {
      content.classList.add("mobile-open");
      overlay.classList.add("active");
      toggle.classList.add("active");
      icon.className = "fas fa-xmark";
      document.body.style.overflow = "hidden";
    }
  });

  overlay.addEventListener("click", closeMobileMenu);

  // Close menu on nav link click
  content.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMobileMenu);
  });

  // Desktop search toggle
  const searchToggle = document.getElementById("search-toggle");
  const searchContainer = document.getElementById("desktop-search");
  const searchInput = document.getElementById(
    "search-input",
  ) as HTMLInputElement | null;

  if (searchToggle && searchContainer && searchInput) {
    searchToggle.addEventListener("click", () => {
      searchContainer.classList.toggle("expanded");
      if (searchContainer.classList.contains("expanded")) {
        setTimeout(() => searchInput.focus(), 100);
      }
    });

    searchInput.addEventListener("blur", () => {
      setTimeout(() => {
        if (!searchInput.value) {
          searchContainer.classList.remove("expanded");
        }
      }, 200);
    });
  }
</script>

<style>
  .nav-bar {
    font-family: var(--title-font);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: calc(12px + env(safe-area-inset-top, 0px)) calc(24px + env(safe-area-inset-right, 0px)) 12px calc(24px + env(safe-area-inset-left, 0px));
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    transition: transform 0.3s ease;
    box-sizing: border-box;
  }

  .nav-bar.nav-hidden {
    transform: translateY(-100%);
  }

  .nav-left a {
    font-size: 1.5rem;
    font-weight: bold;
    font-family: var(--site-title-font);
    color: var(--main-color);
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-content {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nav-menu {
    display: flex;
    list-style: none;
    gap: 8px;
    margin: 0;
    padding: 0;
  }

  .nav-menu li {
    opacity: 1;
    transform: none;
    transition: all 0.4s ease;
  }

  .nav-menu li a {
    display: block;
    padding: 8px 16px;
    color: var(--frame-color);
    text-decoration: none;
    transition: all 0.3s ease;
    position: relative;
    font-family: var(--content-font);
    font-weight: bold;
  }

  .nav-menu li a:hover,
  .nav-menu li a.active {
    color: var(--main-color);
  }

  .nav-menu li a::after {
    content: "";
    position: absolute;
    bottom: 4px;
    left: 50%;
    width: 0;
    height: 2px;
    background-color: var(--main-color);
    transition:
      width 0.3s ease,
      left 0.3s ease;
    border-radius: 2px;
  }

  .nav-menu li a:hover::after,
  .nav-menu li a.active::after {
    width: calc(100% - 32px);
    left: 16px;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  .nav-right.desktop-only {
    position: absolute;
    right: calc(24px + env(safe-area-inset-right, 0px));
    z-index: 1002;
  }

  .nav-right.mobile-only {
    display: none;
  }

  .nav-search {
    display: flex;
    align-items: center;
  }

  .nav-search form {
    display: flex;
    align-items: center;
    background: transparent;
    border: none;
    transition: all 0.3s ease;
  }

  .nav-search .search-input {
    width: 0;
    padding: 0;
    border: none;
    outline: none;
    opacity: 0;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    color: var(--text-color);
    background: var(--input-bg);
    border-radius: 20px;
    font-size: 0.9rem;
  }

  .nav-search.expanded .search-input {
    background: transparent;
    width: 200px;
    padding: 8px 16px;
    opacity: 1;
    margin-right: 8px;
    border: 1px solid var(--border-color);
  }

  .nav-search button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: transparent;
    border: none;
    color: var(--frame-color);
    cursor: pointer;
    transition: all 0.2s;
    border-radius: 50%;
  }

  .nav-search button:hover {
    color: var(--main-color);
  }

  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: var(--nav-bg);
    border: 1px solid var(--border-color);
    color: var(--frame-color);
    cursor: pointer;
    border-radius: 12px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    font-size: 18px;
    z-index: 1002;
  }

  .menu-toggle:hover {
    border-color: var(--main-color);
    color: var(--main-color);
  }

  .mobile-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0.3s ease;
  }

  .mobile-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  /* ===== Mobile ===== */
  @media (max-width: 768px) {
    .nav-bar {
      padding: calc(12px + env(safe-area-inset-top, 0px)) calc(16px + env(safe-area-inset-right, 0px)) 12px calc(16px + env(safe-area-inset-left, 0px));
    }

    .menu-toggle {
      display: flex;
      order: 3;
    }

    .menu-toggle.active {
      background: transparent;
      border-color: transparent;
      color: var(--frame-color);
    }

    .nav-right.desktop-only {
      display: none;
    }

    .nav-content {
      position: fixed;
      left: auto;
      transform: none;
      top: 0;
      right: -100%;
      width: 80%;
      height: 100vh;
      height: 100dvh;
      z-index: 1001;
      background: var(--nav-bg);
      border-left: 1px solid var(--border-color);
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: calc(80px + env(safe-area-inset-top, 0px)) calc(24px + env(safe-area-inset-right, 0px)) calc(24px + env(safe-area-inset-bottom, 0px)) 24px;
      margin: 0;
      box-sizing: border-box;
      transition: right 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: -10px 0 30px rgba(0, 0, 0, 0.1);
    }

    .nav-content.mobile-open {
      right: 0;
    }

    .nav-right.mobile-only {
      display: flex;
      flex-direction: column;
      gap: 24px;
      margin-top: 40px;
      width: 100%;
      align-items: center;
    }

    .nav-menu {
      flex-direction: column;
      gap: 20px;
      width: 100%;
      align-items: center;
    }

    .nav-content:not(.mobile-open) .nav-menu li {
      opacity: 0;
      transform: translateY(20px);
    }

    .nav-menu li {
      transition-delay: calc(var(--i) * 0.1s);
    }

    .nav-menu li a {
      font-size: 1.5rem;
      padding: 12px 24px;
      text-align: center;
    }

    .nav-menu li a:hover::after,
    .nav-menu li a.active::after {
      width: 40px;
      left: calc(50% - 20px);
      bottom: 0;
    }

    .mobile-overlay {
      display: block;
    }

    .nav-right.mobile-only .nav-search {
      width: 100%;
      max-width: 300px;
      justify-content: center;
    }

    .nav-right.mobile-only .nav-search form {
      width: 100%;
      background: rgba(255, 255, 255, 0.05);
      border-radius: 12px;
      padding: 0 4px;
    }

    .nav-right.mobile-only .nav-search .search-input {
      width: 100% !important;
      padding: 10px 16px !important;
      opacity: 1 !important;
      background: var(--input-bg) !important;
      border: 1px solid var(--border-color) !important;
    }
  }

  @media (max-width: 480px) {
    .nav-bar {
      padding: calc(10px + env(safe-area-inset-top, 0px)) calc(12px + env(safe-area-inset-right, 0px)) 10px calc(12px + env(safe-area-inset-left, 0px));
    }
    .nav-left a {
      font-size: 1.25rem;
    }
    .nav-content {
      width: 100%;
    }
  }
</style>
