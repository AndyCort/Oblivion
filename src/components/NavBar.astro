---
/**
 * NavBar.astro — Static Astro navigation bar with minimal inline JS
 * for scroll hide/show and mobile menu toggle.
 */
import { t, getLocale } from "../i18n/utils";

const locale = getLocale();
const siteName = t("siteName", locale);

const menuItems = [
  { key: "home", path: "/" },
  { key: "articles", path: "/article" },
  { key: "about", path: "/about" },
];
const currentPath = Astro.url.pathname;
---

<nav class="nav-bar">
  <div class="nav-pill nav-left">
    <a href="/">{siteName}</a>
  </div>

  <div class="nav-pill nav-middle">
    <ul class="nav-menu">
      {
        menuItems.map((item, index) => (
          <li style={`--i: ${index}`}>
            <a
              href={item.path}
              data-nav-key={item.key}
              class:list={{
                active:
                  item.path === "/"
                    ? currentPath === "/"
                    : currentPath.startsWith(item.path),
              }}
            >
              {t(`nav.${item.key}`, locale)}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="nav-pill nav-right">
    <button
      class="i18n-toggle"
      aria-label="Toggle language"
      title={locale === "zh-CN" ? "Switch to English" : "切换至中文"}
    >
      <i class="fas fa-language"></i>
    </button>

    <div class="nav-search">
      <form action="/search" method="get">
        <input
          type="search"
          name="s"
          placeholder={t("search.placeholder", locale)}
          class="search-input"
        />
        <button type="button" aria-label="Toggle search">
          <i class="fas fa-magnifying-glass"></i>
        </button>
      </form>
    </div>

    <button class="menu-toggle" aria-label="Toggle menu">
      <i class="fas fa-bars"></i>
    </button>
  </div>
</nav>

<script>
  import { toggleLocale } from "../i18n/utils";

  // i18n language toggle
  const i18nToggle = document.querySelector(".i18n-toggle");
  if (i18nToggle) {
    i18nToggle.addEventListener("click", () => {
      toggleLocale();
      window.location.reload();
    });
  }

  // Nav scroll hide/show
  let lastScrollY = 0;
  const nav = document.querySelector<HTMLElement>(".nav-middle");

  window.addEventListener(
    "scroll",
    () => {
      const scrollY = window.scrollY;
      if (scrollY > 100) {
        nav?.classList.toggle("nav-hidden", scrollY > lastScrollY);
      } else {
        nav?.classList.remove("nav-hidden");
        nav?.style.removeProperty("backdrop-filter");
      }
      lastScrollY = scrollY;
    },
    { passive: true },
  );

  // Mobile menu
  const toggle = document.querySelector(".menu-toggle");
  const content = document.querySelector(".nav-middle");
  const icon = toggle?.querySelector("i");

  function closeMobileMenu() {
    content?.classList.remove("mobile-open");
    toggle?.classList.remove("active");
    if (icon) icon.className = "fas fa-bars";
    document.body.style.overflow = "";
  }

  if (toggle && content) {
    toggle.addEventListener("click", () => {
      const isOpen = content.classList.contains("mobile-open");
      if (isOpen) {
        closeMobileMenu();
      } else {
        content.classList.add("mobile-open");
        toggle.classList.add("active");
        if (icon) icon.className = "fas fa-xmark";
        document.body.style.overflow = "hidden";
      }
    });
  }

  // Close menu on nav link click
  content?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMobileMenu);
  });

  // Desktop search toggle
  const searchContainer = document.querySelector(".nav-search");
  const searchToggle = searchContainer?.querySelector("button");
  const searchInput = searchContainer?.querySelector(
    ".search-input",
  ) as HTMLInputElement | null;

  if (searchToggle && searchContainer && searchInput) {
    searchToggle.addEventListener("click", () => {
      searchContainer.classList.toggle("expanded");
      if (searchContainer.classList.contains("expanded")) {
        setTimeout(() => searchInput.focus(), 100);
      }
    });

    searchInput.addEventListener("blur", () => {
      setTimeout(() => {
        if (!searchInput.value) {
          searchContainer.classList.remove("expanded");
        }
      }, 200);
    });
  }
</script>

<style>
  .nav-bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;

    position: fixed;
    inset: 0 0 auto;
    z-index: 1000;

    box-sizing: border-box;
    width: 100%;

    padding: calc(12px + env(safe-area-inset-top))
      calc(24px + env(safe-area-inset-right)) 12px
      calc(24px + env(safe-area-inset-left));

    font-family: var(--title-font);

    transition: transform 0.3s ease;

    &.nav-hidden {
      transform: translateY(-100%);
    }
  }
  .nav-pill {
    display: flex;
    align-items: center;
    padding: 0;
    border-radius: 999px;
    background: var(--nav-bg);
    border: 1px solid color-mix(in srgb, var(--text-color) 8%, transparent);
    box-shadow: 0 8px 30px color-mix(in srgb, var(--text-color) 8%, transparent);
  }

  /* 三个区域定位 */
  .nav-left {
    justify-self: start;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    margin-left: clamp(16px, 4vw, 64px);
    a {
      font-size: 1.5rem;
      font-weight: bold;
      font-family: var(--site-title-font);
      color: var(--main-color);
      text-decoration: none;
      transition: color 0.2s;
    }

    @media (max-width: 384px) {
      display: none;
    }
  }

  .nav-middle {
    justify-self: center;
    .nav-menu {
      display: flex;
      list-style: none;
      gap: 8px;
      margin: 0;
      padding: 0;

      &:hover li a.active:not(:hover) {
        color: var(--frame-color);

        &::after {
          width: 0;
          left: 50%;
        }
      }

      li {
        opacity: 1;
        transform: none;
        transition: all 0.4s ease;

        a {
          display: block;
          padding: 8px 16px;
          color: var(--frame-color);
          text-decoration: none;
          transition: all 0.3s ease;
          position: relative;
          font-family: var(--content-font);
          font-weight: bold;

          &:hover,
          &.active {
            color: var(--main-color);

            &::after {
              width: calc(100% - 32px);
              left: 16px;
            }
          }

          &::after {
            content: "";
            position: absolute;
            bottom: 4px;
            left: 50%;
            width: 0;
            height: 2px;
            background-color: var(--main-color);
            transition:
              width 0.3s ease,
              left 0.3s ease;
            border-radius: 2px;
          }
        }
      }
    }
  }

  .nav-right {
    justify-self: end;
    margin-right: clamp(16px, 4vw, 64px);
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
    padding: 0 4px;

    .i18n-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      background: transparent;
      border: none;
      color: var(--frame-color);
      cursor: pointer;
      transition: all 0.2s;
      border-radius: 50%;
      font-size: 1.15rem;

      &:hover {
        color: var(--main-color);
      }
    }

    .nav-search {
      display: flex;
      align-items: center;

      form {
        display: flex;
        align-items: center;
        background: transparent;
        border: none;
        transition: all 0.3s ease;
      }

      .search-input {
        width: 0;
        padding: 0;
        border: none;
        outline: none;
        opacity: 0;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        color: var(--text-color);
        background: var(--input-bg);
        border-radius: 20px;
        font-size: 0.9rem;
      }

      &.expanded .search-input {
        background: transparent;
        width: 200px;
        padding: 8px 16px;
        opacity: 1;
        margin-right: 8px;
        border: 1px solid var(--border-color);
      }

      button {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        background: transparent;
        border: none;
        color: var(--frame-color);
        cursor: pointer;
        transition: all 0.2s;
        border-radius: 50%;

        &:hover {
          color: var(--main-color);
        }
      }
    }

    .menu-toggle {
      display: none;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      background: var(--nav-bg);
      border: 1px solid var(--border-color);
      color: var(--frame-color);
      cursor: pointer;
      border-radius: 12px;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      font-size: 18px;
      z-index: 1002;

      &:hover {
        border-color: var(--main-color);
        color: var(--main-color);
      }
    }
  }
</style>
