---
/**
 * Toc.astro — Table of Contents
 * Desktop: sticky sidebar on the right
 * Mobile: FAB button → bottom sheet
 * Active heading tracking via IntersectionObserver (client JS)
 */

interface TocItem {
  id: string
  text: string
  level: number
}

interface Props {
  headings: TocItem[]
}

const { headings = [] } = Astro.props
---

{headings.length > 0 && (
  <!-- Desktop Sidebar -->
  <nav class="toc-sidebar" aria-label="Table of Contents">
    <div class="toc-sidebar-title">目录</div>
    <ul class="toc-list">
      {headings.map((h) => (
        <li>
          <a
            class="toc-link"
            href={`#${h.id}`}
            data-toc-id={h.id}
            data-depth={h.level}
            style={`padding-left: ${16 + (h.level - 1) * 14}px; font-size: ${h.level === 1 ? '0.85rem' : '0.8rem'}; font-weight: ${h.level === 1 ? 600 : 400};`}
          >
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- Mobile FAB -->
  <button class="toc-fab" id="toc-fab" aria-label="Table of Contents">
    <i class="fas fa-list-ul"></i>
  </button>

  <!-- Mobile Bottom Sheet -->
  <div class="toc-overlay" id="toc-overlay">
    <div class="toc-sheet" id="toc-sheet">
      <div class="toc-sheet-handle"></div>
      <div class="toc-sheet-title">目录</div>
      {headings.map((h) => (
        <a
          class="toc-sheet-link"
          href={`#${h.id}`}
          data-toc-id={h.id}
          data-depth={h.level}
          style={`padding-left: ${20 + (h.level - 1) * 16}px; font-size: ${h.level === 1 ? '0.95rem' : '0.9rem'}; font-weight: ${h.level === 1 ? 600 : 400};`}
        >
          {h.text}
        </a>
      ))}
    </div>
  </div>
)}

<style>
  /* ===== Desktop Sidebar ===== */
  .toc-sidebar {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--glass-border-color);
    border-radius: 12px;
    position: fixed;
    top: calc(110px + env(safe-area-inset-top, 0px));
    right: max(calc((100vw - 900px) / 2 - 280px), calc(20px + env(safe-area-inset-right, 0px)));
    width: 220px;
    max-height: calc(100vh - 140px - env(safe-area-inset-top, 0px));
    max-height: calc(100dvh - 140px - env(safe-area-inset-top, 0px));
    overflow-y: auto;
    z-index: 10;
    padding: 16px 0;
  }

  .toc-sidebar::-webkit-scrollbar { width: 3px; }
  .toc-sidebar::-webkit-scrollbar-thumb {
    background: var(--glass-border-color);
    border-radius: 4px;
  }

  @media (max-width: 1300px) {
    .toc-sidebar { display: none; }
  }

  .toc-sidebar-title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-color);
    opacity: 0.45;
    margin-bottom: 12px;
    padding: 0 16px;
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc-link {
    display: block;
    padding: 6px 16px;
    line-height: 1.5;
    color: var(--text-color);
    opacity: 0.55;
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .toc-link:hover {
    opacity: 1;
    color: var(--main-color);
  }

  .toc-link.active {
    color: var(--main-color);
    opacity: 1;
    border-left-color: var(--main-color);
  }

  /* ===== Mobile FAB ===== */
  .toc-fab {
    display: none;
    position: fixed;
    bottom: calc(90px + env(safe-area-inset-bottom, 0px));
    right: calc(20px + env(safe-area-inset-right, 0px));
    z-index: 900;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--glass-border-color);
    background: var(--glass-bg-color);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    color: var(--text-color);
    font-size: 18px;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s;
  }

  .toc-fab:active { transform: scale(0.92); }

  @media (max-width: 1300px) {
    .toc-fab { display: flex; }
  }

  /* ===== Bottom Sheet Overlay ===== */
  .toc-overlay {
    position: fixed;
    inset: 0;
    z-index: 999;
    background: rgba(0, 0, 0, 0.4);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .toc-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  /* ===== Bottom Sheet ===== */
  .toc-sheet {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    max-height: 60vh;
    background: var(--glass-bg-color);
    border-top: 1px solid var(--glass-border-color);
    border-radius: 20px 20px 0 0;
    padding: 12px 0 calc(20px + var(--safe-area-inset-bottom, 0px));
    overflow-y: auto;
    transform: translateY(100%);
    transition: transform 0.28s ease-out;
  }

  .toc-overlay.open .toc-sheet {
    transform: translateY(0);
  }

  .toc-sheet::-webkit-scrollbar { width: 3px; }
  .toc-sheet::-webkit-scrollbar-thumb {
    background: var(--glass-border-color);
    border-radius: 4px;
  }

  .toc-sheet-handle {
    width: 36px;
    height: 4px;
    border-radius: 2px;
    background: var(--text-color);
    opacity: 0.2;
    margin: 0 auto 12px;
  }

  .toc-sheet-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-color);
    opacity: 0.5;
    padding: 0 20px 10px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .toc-sheet-link {
    display: block;
    padding: 10px 20px;
    color: var(--text-color);
    opacity: 0.65;
    text-decoration: none;
    transition: all 0.15s;
    cursor: pointer;
  }

  .toc-sheet-link:active {
    background: rgba(255, 255, 255, 0.06);
  }

  .toc-sheet-link.active {
    color: var(--main-color);
    opacity: 1;
  }
</style>

<script>
  // --- Active heading tracking via IntersectionObserver ---
  function initToc() {
    const allLinks = document.querySelectorAll<HTMLAnchorElement>('[data-toc-id]')
    if (allLinks.length === 0) return

    const ids = [...new Set(Array.from(allLinks).map(l => l.dataset.tocId!))]

    let activeId = ''

    function setActive(id: string) {
      if (id === activeId) return
      activeId = id
      allLinks.forEach(link => {
        link.classList.toggle('active', link.dataset.tocId === id)
      })
    }

    // IntersectionObserver
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter(e => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)
        if (visible.length > 0) {
          setActive(visible[0].target.id)
        }
      },
      { rootMargin: '-80px 0px -60% 0px', threshold: 0.1 }
    )

    // Wait a bit for content to render, then observe headings
    setTimeout(() => {
      ids.forEach(id => {
        const el = document.getElementById(id)
        if (el) observer.observe(el)
      })
    }, 300)

    // Smooth scroll on click
    allLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault()
        const id = link.dataset.tocId!
        const el = document.getElementById(id)
        if (el) {
          el.scrollIntoView({ behavior: 'smooth', block: 'start' })
          setActive(id)
        }
        // Close sheet if open
        const overlay = document.getElementById('toc-overlay')
        overlay?.classList.remove('open')
      })
    })

    // Mobile FAB → open sheet
    const fab = document.getElementById('toc-fab')
    const overlay = document.getElementById('toc-overlay')

    fab?.addEventListener('click', () => {
      overlay?.classList.add('open')
    })

    overlay?.addEventListener('click', (e) => {
      if (e.target === overlay) {
        overlay.classList.remove('open')
      }
    })
  }

  // Run on initial page load
  initToc()

  // Re-run on Astro page transitions (View Transitions)
  document.addEventListener('astro:after-swap', initToc)
</script>
