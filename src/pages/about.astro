---
import MainLayout from "../layouts/MainLayout.astro";
import Background from "../components/Background";
import SideButton from "../components/SideButton";
import MusicIsland from "../components/MusicIsland";
import { getLocale } from "../i18n/utils";

const locale = getLocale();

const titleText = locale === "zh-CN" ? "关于我" : "About Me";
const bioText =
    locale === "zh-CN"
        ? "你好！我是个热爱探索与创造的开发者。我喜欢将优雅的设计和现代的前端技术相结合，创造令人印象深刻的数字体验。欢迎来到我的数字花园，在这里分享技术、生活与思考。"
        : "Hello! I am a developer passionate about exploration and creation. I love combining elegant design with modern frontend technologies to create impressive digital experiences. Welcome to my digital garden.";
---

<MainLayout title={`${titleText} — Oblivion`} description={bioText}>
    <Fragment slot="before-wrapper">
        <SideButton client:idle />
        <MusicIsland client:idle />
        <Background client:idle />
    </Fragment>

    <div class="about-container">123</div>
</MainLayout>

<style>
    .about-container {
        padding: 120px 20px 60px;
        max-width: 800px;
        margin: 0 auto;
        min-height: 100vh;
        min-height: 100svh;
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
        z-index: 10;
    }

    .about-card {
        width: 100%;
        padding: 50px;
        text-align: center;
        transition:
            transform 0.3s ease,
            box-shadow 0.3s ease;

        &:hover {
            transform: translateY(-5px);
        }

        @media (max-width: 768px) {
            padding: 30px 20px;
        }
    }

    .avatar-container {
        width: 150px;
        height: 150px;
        margin: 0 auto 30px;
        border-radius: 50%;
        padding: 5px;
        background: linear-gradient(135deg, var(--main-color), #ffb6c1);
        position: relative;
        box-shadow: 0 10px 25px rgba(251, 113, 133, 0.2);

        .avatar {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 50%;
            border: 4px solid var(--glass-bg-color);
            transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        &:hover .avatar {
            transform: scale(1.08) rotate(5deg);
        }

        @media (max-width: 768px) {
            width: 120px;
            height: 120px;
        }
    }

    .about-title {
        font-size: 2.8rem;
        font-family: var(--title-font);
        color: var(--title-color);
        margin-bottom: 20px;
        background: linear-gradient(45deg, var(--main-color), #ffb6c1);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;

        @media (max-width: 768px) {
            font-size: 2.2rem;
        }
    }

    .about-bio {
        font-size: 1.15rem;
        line-height: 1.8;
        color: var(--text-color);
        margin-bottom: 50px;
        max-width: 650px;
        margin-left: auto;
        margin-right: auto;
        opacity: 0.9;
    }

    .section-subtitle {
        font-size: 1.6rem;
        color: var(--title-color);
        margin-bottom: 25px;
        font-family: var(--title-font);
    }

    .skills-section {
        margin-bottom: 50px;
    }

    .skills-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        justify-content: center;
    }

    .skill-tag {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 24px;
        font-size: 1.05rem;
        color: var(--text-color);
        transition: all 0.3s ease;
        cursor: default;
        border-radius: 12px;

        i {
            color: var(--main-color);
            font-size: 1.2rem;
            transition: all 0.3s ease;
        }

        &:hover {
            background: var(--main-color);
            color: #fff;
            transform: translateY(-5px);

            i {
                color: #fff;
            }
        }

        @media (max-width: 768px) {
            padding: 10px 20px;
            font-size: 1rem;
        }
    }

    .social-links {
        display: flex;
        gap: 20px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .social-btn {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 30px;
        font-size: 1.1rem;
        color: var(--text-color);
        font-weight: 500;
        transition: all 0.3s ease;
        border-radius: 12px;
        text-decoration: none;

        i {
            font-size: 1.4rem;
            color: var(--main-color);
            transition: all 0.3s ease;
        }

        &:hover {
            background: var(--main-color);
            color: #fff;
            transform: translateY(-5px) scale(1.05);

            i {
                color: #fff;
            }
        }

        @media (max-width: 768px) {
            padding: 10px 20px;
            font-size: 1rem;
        }
    }
</style>
