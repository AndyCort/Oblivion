{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "outDir": "node_modules/.tmp/tsc-node",
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": [
    "vite.config.ts",
    "src/config/theme.config.ts"
  ]
}